# Copy this file to .env, or let install.ps1/install.sh create .env for you.
# Never commit .env. Paths may be absolute Windows paths (use C:/path syntax)
# or absolute Linux paths. Avoid network shares until the stack works locally.

MEDIA_ROOT=./data/media
DOWNLOADS_ROOT=./data/downloads
CONFIG_ROOT=./data/config

# LinuxServer containers use these IDs for file ownership on Linux.
# Find them with: id -u  and  id -g. Docker Desktop users can keep 1000.
PUID=1000
PGID=1000
TZ=Etc/UTC

# Gluetun provider identifier, such as mullvad, nordvpn, protonvpn, or custom.
# Find supported providers and required variables in Gluetun's provider docs:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=your-provider
VPN_TYPE=openvpn
SERVER_COUNTRIES=

# OpenVPN: obtain service credentials from your VPN provider. These are often
# different from the credentials used to sign in to the provider's website.
OPENVPN_USER=
OPENVPN_PASSWORD=

# WireGuard: set VPN_TYPE=wireguard and obtain both values from your provider.
# Do not paste a WireGuard configuration file into this repository.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Host ports. Change the left-side host value here if a port is already used.
QBITTORRENT_WEBUI_PORT=8080
TORRENTING_PORT=6881
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
JELLYFIN_PORT=8096
SEERR_PORT=5055
